# Copy to .env for local development. Never commit the real .env.
ENVIRONMENT=development
DEBUG=true

# SQLite lives under backend/var/ which is git-ignored.
DATABASE_URL=sqlite+aiosqlite:///./var/signal.db

# Generate a real one for production:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-secret-do-not-use-in-production
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# Mocked verification, per the assignment brief. No SMS provider is involved.
MOCK_OTP_CODE=123456
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
MAX_UPLOAD_BYTES=10485760
